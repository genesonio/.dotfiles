[global]
    font = FiraCode Nerd Font 10
    origin = top-right
    offset = (10, 10)
    width = 350
    padding = 10
    horizontal_padding = 12
    gap_size = 4
    frame_width = 1
    frame_color = "#3d59a1"
    separator_color = frame
    corner_radius = 5
    # by default scripts also run while paused (SUPER+N), which would beep while muted
    always_run_script = false

[urgency_low]
    background = "#1a1b26"
    foreground = "#787c99"
    timeout = 5

[urgency_normal]
    background = "#1a1b26"
    foreground = "#a9b1d6"
    timeout = 8

[urgency_critical]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#f7768e"
    timeout = 0

[sound]
    summary = "*"
    script = ~/.config/dunst/notify-sound
