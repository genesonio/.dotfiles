{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-center": ["clock"],

  "modules-right": [
    "pulseaudio",
    "custom/music",
    "network",
    "cpu",
    "memory",
    "tray",
    "custom/notifications",
    "custom/lock",
    "custom/shutdown"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "urgent": "󰵚"
    }
  },
  
  "hyprland/window": {
    "max-length": 25,
    "separate-outputs": true
  },

  "tray": {
    "icon-size": 12,
    "spacing": 10
  },

  "custom/music": {
    "exec": "~/.config/waybar/scripts/music.sh",
    "return-type": "json",
    "tooltip": false,
    "on-click": "playerctl play-pause"
  },

  "clock": {
    "timezone": "America/Sao_Paulo",
    "tooltip-format": "<big>{:%Y %B}</big>\n<big><tt>{calendar}</tt></big>",
    "format": "{:%d/%m/%Y - %H:%M}",
    "interval": 60
  },

  "network": {
    "format-wifi": "{frequency}󰤢  {essid}",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰤠 ",
    "interval": 5,
    "tooltip": false
  },

  "cpu": {
    "interval": 1,
    "format": "  {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
  },

  "memory": {
    "interval": 30,
    "format": "  {used:0.1f}G/{total:0.1f}G"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "]
    },
    "on-click": "pavucontrol",
    "tooltip": false
  },

  "bluetooth": {
        // "controller": "controller1", // specify the alias of the controller if there are more than 1 on the system
        "format": "󰂯 {status}",
        // format-* handles every state, so default format is not necessary.
        "format-on": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "", // an empty format will hide the module
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}"
  },

  "custom/notifications": {
    "exec": "dunstctl is-paused | grep -q true && i='󰂛' || i='󰂚'; printf '{\"text\":\"%s\",\"tooltip\":\"Sound %s%% (scroll to change)\"}\\n' \"$i\" \"$(cat ~/.local/state/notify-volume 2>/dev/null || echo 100)\"",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "dunstctl set-paused toggle && pkill -RTMIN+8 waybar",
    "on-scroll-up": "~/.config/dunst/notify-sound up",
    "on-scroll-down": "~/.config/dunst/notify-sound down"
  },

  "custom/lock": {
    "tooltip": false,
    "on-click": "loginctl lock-session",
    "format": " "
  },

  "custom/shutdown": {
    "tooltip": false,
    "on-click": "printf 'No\\nYes' | $HOME/.local/bin/vicinae dmenu -n 'Shut down?' --no-section --no-footer -H 200 | grep -qx Yes && systemctl poweroff",
    "format": " "
  }
}
