configuration {
    kb-cancel: "Escape";
    kb-accept-entry: "Return";
    kb-mode-next: "Alt+Tab";
    kb-mode-previous: "Alt+Shift+Tab";

    kb-clear-line: "Control+a";
    kb-move-front: "";

    drun {
      display-name: "";
    }

    calc {
      display-name: "";
    }

}

* {
  bg: #1a1b26;
  fg: #a9b1d6;
  fg-dim: #787c99;
  accent: #bb9af7;
  outline: #3d59a1;
  selected: #28344a;

  foreground: @fg;
  normal-foreground: @fg;
  separatorcolor: @outline;

  background-color: @bg;
  text-color: @fg;
  font: "FiraCode Nerd Font 11";
  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  width: 600px;
  border: 1px;
  border-color: @outline;
  border-radius: 5px;
}

mainbox {
  padding: 6px;
}

inputbar {
  children: [prompt, entry];
  padding: 2px 0 8px 0;
}

prompt {
  text-color: @accent;
  padding: 2px 6px;
}

entry {
  padding: 2px 6px;
  placeholder-color: @fg-dim;
}

listview {
  lines: 8;
  border: 1px 0 0 0;
  padding: 4px 0 0 0;
}

message {
  border: 1px 0 0 0;
  padding: 4px 0;
}

element {
  padding: 6px 8px;
  border-radius: 4px;
}

element normal.normal,
element alternate.normal {
  background-color: @bg;
  text-color: @fg-dim;
}

element selected.normal {
  background-color: @selected;
  text-color: @fg;
}

element-text,
element-icon {
  background-color: inherit;
  text-color: inherit;
}
